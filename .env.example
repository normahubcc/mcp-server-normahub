# NormaHub API key: https://normahub.cc/dashboard
NORMAHUB_API_KEY=nr_hub_your_key_here

# Override only when you use a proxy or a self-hosted gateway.
NORMAHUB_BASE_URL=https://api.normahub.cc/v1

# Model used when normahub_prompt_model is called without a model id.
NORMAHUB_DEFAULT_MODEL=claude-sonnet-5-5

# Model used when a video tool is called without a model id.
# Empty means "first video model in the live catalog".
NORMAHUB_DEFAULT_VIDEO_MODEL=

# Text request timeout in milliseconds (default 120000).
NORMAHUB_TIMEOUT_MS=120000

# Set to 1 to use the bundled model snapshot and skip the live catalog.
NORMAHUB_OFFLINE=0

# HTTP transport only.
PORT=3001
HOST=0.0.0.0
